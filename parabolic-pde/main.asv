theta = 0; % Choose 0 for forward Euler, 0.5 for CN and 1 for backward Euler
h = 0.1; % mesh size
x = 0:h:1; % mesh
xin = x(2:end-1)'; % Interior nodes
T = 5; % final time
dt = 0.025; % Time step
nsteps = round(T/dt); % Number of time steps

M = MassAssembler(x);
A = StiffnessAssembler(x);
K = (1/pi^2)*A - 3*M;

sol = zeros(length(x),nsteps+1);
sol(2:end-1,1) = sin(2*pi*xin);


for i=2:nsteps+1
    sol(2:end-1,i) = thetaMethod(sol(2:end-1,i-1), dt, theta, M, K);
end

% Computing error normes
uex  = @(x,t) exp(-t).*sin(2*pi*x); 
duex = @(x,t) 2*pi*exp(-t).*cos(2*pi*x);   % derivative in x


% Numerical solution at times 0,1,2 and 5
t  = (0:nsteps)*dt;
figure; hold on
for times = [5]
    n = round(times/dt) + 1;
    plot(x, sol(:,n), '-')
end
xlabel('x'); ylabel('u'); title('Numerical solution'); xlim([0 1])

% Surface plot
figure
surf(t, x, sol, 'EdgeColor','none')
xlabel('t'); ylabel('x'); zlabel('u')