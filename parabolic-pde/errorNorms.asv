function [eL2, eV2] = errorNorms(x, sol, t)
% Computes the L2-norm and the V-norm of the error (numerical solution
% minusxact solution)
xf  = linspace(0, 1, 10*(numel(x)-1) + 1);       % 10 points per element, nodes included
ef  = exp(-t)*sin(2*pi*xf) - interp1(x, sol, xf);
eL2 = sqrt(trapz(xf, ef.^2));
eV2 = sum(diff(ef).^2 ./ diff(xf));              % squared V-norm
end